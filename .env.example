# ==============================================================================
# TracePilot Root Environment Configuration Template
# For repository-wide deployment and local environment setup.
# Backend configuration lives in `backend/.env`.
# Frontend configuration lives in `frontend/.env`.
# WARNING: Never commit real secrets or credentials into version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Core Settings (backend/.env)
# ------------------------------------------------------------------------------
APP_NAME=TracePilot
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api

# Database Settings (PostgreSQL 14+ / 18 with psycopg3 async driver)
DB_DRIVER=postgresql+psycopg
DB_USER=postgres
DB_PASSWORD=YOUR_POSTGRES_PASSWORD
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=bugtracker_db

# Legacy database fallback (Optional)
# DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@127.0.0.1:5432/bugtracker_db

# JWT Authentication
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# OTP Email Verification
OTP_EXPIRE_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# SMTP Email Dispatcher (e.g., Gmail App Passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=TracePilot
SMTP_USE_TLS=true

# AI Advisory Engine (Dual-Provider Architecture)
AI_ENABLED=false
AI_PROVIDER=groq
AI_MODEL=openai/gpt-oss-120b

# Groq API Configuration (Primary production provider)
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# Google Gemini API Configuration (Alternative provider)
GEMINI_API_KEY=your-gemini-api-key
MAX_MESSAGE_LENGTH=4000

# File Attachment Storage
ATTACHMENT_STORAGE_PATH=storage/attachments
ATTACHMENT_MAX_SIZE_MB=10
ATTACHMENT_ALLOWED_MIME_TYPES=image/png,image/jpeg,image/webp,application/pdf,text/plain,text/csv

# ------------------------------------------------------------------------------
# Frontend Environment Settings (frontend/.env)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_WS_BASE_URL=ws://127.0.0.1:8000
