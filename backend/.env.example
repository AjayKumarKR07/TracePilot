# ==============================================================================
# TracePilot Backend Environment Configuration Template
# Copy this file to `backend/.env` and supply your actual credentials.
# WARNING: Never commit `.env` or real secrets into version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Application Core Settings
# ------------------------------------------------------------------------------
APP_NAME=TracePilot
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api

# ------------------------------------------------------------------------------
# Database Settings (PostgreSQL with psycopg3 async driver)
# Note: Using individual DB_* parameters prevents URL-encoding issues with passwords
# ------------------------------------------------------------------------------
DB_DRIVER=postgresql+psycopg
DB_USER=postgres
DB_PASSWORD=YOUR_POSTGRES_PASSWORD
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=bugtracker_db

# Legacy fallback URL (Used only if individual DB_* variables are omitted)
# DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@127.0.0.1:5432/bugtracker_db

# ------------------------------------------------------------------------------
# JWT Authentication & Token Lifecycle
# Generate a secure key via: python -c "import secrets; print(secrets.token_hex(64))"
# ------------------------------------------------------------------------------
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ------------------------------------------------------------------------------
# One-Time Password (OTP) Verification
# ------------------------------------------------------------------------------
OTP_EXPIRE_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# ------------------------------------------------------------------------------
# SMTP / Email Notification Service (e.g., Gmail App Passwords)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=TracePilot
SMTP_USE_TLS=true

# ------------------------------------------------------------------------------
# AI Advisory Assistant (Dual-Provider Architecture)
# Primary: Groq (openai/gpt-oss-120b) with automatic model fallback
# Alternative: Google Gemini (gemini-2.0-flash via google-genai)
# ------------------------------------------------------------------------------
AI_ENABLED=false
AI_PROVIDER=groq
AI_MODEL=openai/gpt-oss-120b

# Groq API Configuration (Get key: https://console.groq.com/keys)
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# Google Gemini Configuration (Get key: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your-gemini-api-key
MAX_MESSAGE_LENGTH=4000

# ------------------------------------------------------------------------------
# File Attachment Storage & Guardrails
# ------------------------------------------------------------------------------
ATTACHMENT_STORAGE_PATH=storage/attachments
ATTACHMENT_MAX_SIZE_MB=10
ATTACHMENT_ALLOWED_MIME_TYPES=image/png,image/jpeg,image/webp,application/pdf,text/plain,text/csv
